---
import { Icon } from 'astro-icon/components';

const reasons = [
	{
		icon: "lucide:calendar-check",
		title: "+15 Años con la Comunidad",
		description: "Don Héctor y su familia llevan más de 15 años sirviendo a Bonito Oriental. No somos un taller nuevo — somos sus vecinos de toda la vida."
	},
	{
		icon: "lucide:shield-check",
		title: "Cada Soldadura se Prueba",
		description: "Usamos materiales de primera y revisamos cada unión antes de entregar. Si no queda bien, no sale del taller."
	},
	{
		icon: "lucide:hand-coins",
		title: "Cotización Gratis, Sin Sorpresas",
		description: "Le damos precio antes de empezar y ese es el precio final. Sin costos ocultos ni cobros de última hora."
	},
	{
		icon: "lucide:heart-handshake",
		title: "Trato Directo con el Dueño",
		description: "Usted habla directamente con Don Héctor. Sin intermediarios, sin demoras — la confianza de un trato personal."
	}
];
---

<section id="por-que-elegirnos" class="py-20 md:py-28 px-4 bg-iron metal-texture">
	<div class="max-w-6xl mx-auto">
		<div class="grid grid-cols-1 lg:grid-cols-5 gap-10 lg:gap-16 items-start">

			<!-- Left column: heading + intro -->
			<div class="lg:col-span-2 text-center lg:text-left">
				<div class="inline-block mb-4">
					<span class="font-heading text-sm tracking-widest uppercase text-welding-orange gsap-hidden">
						Taller Los Camilos
					</span>
				</div>
				<h2 class="font-heading text-3xl md:text-4xl lg:text-5xl font-bold text-smoke leading-tight mb-6 gsap-hidden">
					¿Por qué confiar
					<span class="relative inline-block">
						en nosotros?
						<span class="absolute -bottom-1 left-0 w-full h-1 bg-welding-orange rounded-full gsap-hidden" aria-hidden="true"></span>
					</span>
				</h2>
				<p class="text-ash text-lg leading-relaxed max-w-md mx-auto lg:mx-0">
					Más que un taller de soldadura — somos una familia comprometida con hacer las cosas bien para nuestra comunidad.
				</p>
			</div>

			<!-- Right column: reasons list -->
			<div class="lg:col-span-3 space-y-5" id="reasons-list">
				{reasons.map((reason, index) => (
					<div
						class="reason-row flex items-start gap-5 p-5 rounded-xl bg-steel/50 border border-white/5 hover:border-welding-orange/30 transition-all duration-300 group"
					>
						<!-- Icon -->
						<div class="shrink-0 w-12 h-12 bg-charcoal rounded-lg flex items-center justify-center group-hover:bg-welding-orange/15 transition-colors">
							<Icon
								name={reason.icon}
								class="w-6 h-6 text-welding-orange"
								aria-hidden="true"
							/>
						</div>

						<!-- Text -->
						<div class="min-w-0">
							<h3 class="font-heading text-lg font-semibold text-smoke mb-1 group-hover:text-welding-orange transition-colors">
								{reason.title}
							</h3>
							<p class="text-ash text-sm leading-relaxed">
								{reason.description}
							</p>
						</div>

						<!-- Number accent -->
						<span
							class="hidden sm:flex shrink-0 items-center justify-center w-8 h-8 rounded-full border border-welding-orange/20 text-welding-orange/40 font-heading text-sm"
							aria-hidden="true"
						>
							{String(index + 1).padStart(2, '0')}
						</span>
					</div>
				))}
			</div>

		</div>
	</div>
</section>

<script>
	import {
		gsap, reveal, isReducedMotion, animateSectionTitle,
		EASE, DURATION, STAGGER, defaultScrollTrigger,
	} from '../scripts/gsap-init';

	function initWhyChooseUsAnimation() {
		const section = document.querySelector('#por-que-elegirnos');
		if (!section) return;

		const tagline = section.querySelector('.font-heading.text-sm');
		const heading = section.querySelector('h2');
		const underline = section.querySelector('h2 .absolute');
		const rows = section.querySelectorAll('.reason-row');

		if (!rows.length) return;

		// Reveal gsap-hidden elements (heading area only)
		if (tagline) reveal(tagline);
		if (heading) reveal(heading);
		if (underline) reveal(underline);

		// Rows use autoAlpha instead of gsap-hidden for robustness
		gsap.set(rows, { autoAlpha: 0 });

		if (isReducedMotion()) {
			gsap.to(rows, {
				autoAlpha: 1,
				duration: 0.3,
				stagger: 0.05,
				scrollTrigger: {
					trigger: section,
					start: 'top 80%',
					toggleActions: 'play none none reverse',
				},
			});
			if (tagline) {
				gsap.from(tagline, { opacity: 0, duration: 0.3, scrollTrigger: defaultScrollTrigger(section) });
			}
			if (heading) {
				gsap.from(heading, { opacity: 0, duration: 0.3, scrollTrigger: defaultScrollTrigger(section) });
			}
			return;
		}

		const isMobile = window.matchMedia('(max-width: 767px)').matches;

		// Animate tagline
		if (tagline) {
			gsap.from(tagline, {
				y: 10,
				opacity: 0,
				duration: 0.5,
				ease: EASE.entrance,
				scrollTrigger: defaultScrollTrigger(section),
			});
		}

		// Animate heading
		if (heading) {
			if (isMobile) {
				gsap.from(heading, {
					y: 20,
					opacity: 0,
					duration: DURATION.default,
					ease: EASE.entrance,
					scrollTrigger: defaultScrollTrigger(section),
				});
			} else {
				gsap.from(heading, {
					clipPath: 'inset(0 50% 0 50%)',
					duration: DURATION.default,
					ease: EASE.emphasis,
					scrollTrigger: defaultScrollTrigger(section),
				});
			}
		}

		// Animate underline
		if (underline) {
			gsap.from(underline, {
				scaleX: 0,
				duration: 0.6,
				ease: EASE.entrance,
				delay: 0.3,
				scrollTrigger: defaultScrollTrigger(section),
			});
		}

		// Animate reason rows
		if (isMobile) {
			gsap.to(rows, {
				autoAlpha: 1,
				y: 0,
				duration: 0.6,
				stagger: STAGGER.default,
				ease: EASE.entrance,
				scrollTrigger: {
					trigger: rows[0],
					start: 'top 85%',
					toggleActions: 'play none none reverse',
				},
			});
			gsap.set(rows, { y: 20 });
		} else {
			gsap.set(rows, { x: 60 });
			gsap.to(rows, {
				autoAlpha: 1,
				x: 0,
				duration: 0.7,
				stagger: STAGGER.cards,
				ease: EASE.entrance,
				scrollTrigger: {
					trigger: rows[0],
					start: 'top 85%',
					toggleActions: 'play none none reverse',
				},
			});

			// Icon containers scale in
			const icons = section.querySelectorAll('#reasons-list .w-12');
			if (icons.length) {
				gsap.from(icons, {
					scale: 0,
					duration: 0.5,
					stagger: STAGGER.cards,
					ease: EASE.bounce,
					scrollTrigger: {
						trigger: rows[0],
						start: 'top 80%',
						toggleActions: 'play none none reverse',
					},
				});
			}
		}
	}

	initWhyChooseUsAnimation();
</script>
