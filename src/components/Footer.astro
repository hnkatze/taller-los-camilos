---
const currentYear = new Date().getFullYear();
const phone = "99505549";
const whatsappLink = `https://wa.me/504${phone}`;
const phoneLink = `tel:+504${phone}`;

const navLinks = [
	{ href: "#inicio", label: "Inicio" },
	{ href: "#servicios", label: "Servicios" },
	{ href: "#galeria", label: "Galería" },
	{ href: "#contacto", label: "Contacto" },
];
---

<footer aria-label="Pie de página" class="border-t-2 border-welding-orange bg-[#141414]">
	<div class="max-w-6xl mx-auto px-4 py-12 md:py-16">
		<div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-8 lg:gap-12 text-center md:text-left">

			<!-- Column 1: Brand -->
			<div>
				<a href="#" class="inline-flex items-center gap-2 mb-4 group">
					<svg
						class="w-6 h-6 text-welding-orange transition-transform group-hover:scale-110"
						fill="none"
						stroke="currentColor"
						viewBox="0 0 24 24"
						aria-hidden="true"
					>
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
					</svg>
					<span class="font-heading text-xl font-bold text-smoke tracking-wide">
						TALLER LOS CAMILOS
					</span>
				</a>
				<p class="text-ash text-sm leading-relaxed max-w-xs mx-auto md:mx-0">
					Soldadura profesional y fabricación metálica de calidad en Bonito Oriental, Colón.
				</p>
			</div>

			<!-- Column 2: Quick Links -->
			<div>
				<h4 class="font-heading text-base font-semibold text-smoke uppercase tracking-wider mb-4">
					Enlaces
				</h4>
				<nav aria-label="Enlaces del pie de página">
					<ul class="space-y-3">
						{navLinks.map((link) => (
							<li>
								<a
									href={link.href}
									class="text-ash text-sm hover:text-welding-orange transition-colors"
								>
									{link.label}
								</a>
							</li>
						))}
					</ul>
				</nav>
			</div>

			<!-- Column 3: Contact Info -->
			<div>
				<h4 class="font-heading text-base font-semibold text-smoke uppercase tracking-wider mb-4">
					Contacto
				</h4>
				<ul class="space-y-4">
					<!-- Phone -->
					<li>
						<a
							href={phoneLink}
							class="inline-flex items-center gap-3 text-ash text-sm hover:text-welding-orange transition-colors group"
						>
							<svg
								class="w-5 h-5 text-welding-orange shrink-0"
								fill="none"
								stroke="currentColor"
								viewBox="0 0 24 24"
								aria-hidden="true"
							>
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
							</svg>
							<span>+504 {phone.slice(0, 4)}-{phone.slice(4)}</span>
						</a>
					</li>

					<!-- WhatsApp -->
					<li>
						<a
							href={whatsappLink}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-3 text-ash text-sm hover:text-[#25D366] transition-colors group"
							aria-label="Escríbenos por WhatsApp"
						>
							<svg
								class="w-5 h-5 text-[#25D366] shrink-0"
								fill="currentColor"
								viewBox="0 0 24 24"
								aria-hidden="true"
							>
								<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
							</svg>
							<span>WhatsApp</span>
						</a>
					</li>

					<!-- Location -->
					<li class="inline-flex items-center gap-3 text-ash text-sm md:items-start">
						<svg
							class="w-5 h-5 text-welding-orange shrink-0 mt-0.5"
							fill="none"
							stroke="currentColor"
							viewBox="0 0 24 24"
							aria-hidden="true"
						>
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
						</svg>
						<span>Bonito Oriental, Colón, Honduras</span>
					</li>

					<!-- Hours -->
					<li class="inline-flex items-center gap-3 text-ash text-sm">
						<svg
							class="w-5 h-5 text-welding-orange shrink-0"
							fill="none"
							stroke="currentColor"
							viewBox="0 0 24 24"
							aria-hidden="true"
						>
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
						</svg>
						<span>Lun - Vie: 7 - 12, 1 - 4 PM</span>
						<span class="text-ash text-xs block mt-0.5">Sáb: 7 - 12 PM · Dom: Cerrado</span>
					</li>
				</ul>
			</div>
		</div>
	</div>

	<!-- Bottom bar -->
	<div class="border-t border-steel">
		<div class="max-w-6xl mx-auto px-4 py-5">
			<p class="text-ash/60 text-xs text-center">
				&copy; {currentYear} Taller Los Camilos. Todos los derechos reservados.
			</p>
		</div>
	</div>
</footer>
