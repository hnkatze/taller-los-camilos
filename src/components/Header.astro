---
const navLinks = [
	{ href: "#servicios", label: "Servicios", section: "servicios" },
	{ href: "#galeria", label: "Galería", section: "galeria" },
	{ href: "#contacto", label: "Contacto", section: "contacto" },
];

const whatsappLink = "https://wa.me/50499505549";
---

<header
	id="site-header"
	class="fixed top-0 left-0 right-0 z-50 bg-charcoal/90 backdrop-blur-md transition-all duration-300 ease-out"
>
	<div class="absolute bottom-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-welding-orange/60 to-transparent"></div>

	<nav class="max-w-6xl mx-auto px-4 sm:px-6 py-5 flex items-center justify-between transition-all duration-300" aria-label="Navegación principal">
		<!-- Logo -->
		<a href="/" class="group flex items-center gap-2.5 no-underline" aria-label="Taller Los Camilos - Inicio">
			<svg class="w-7 h-7 md:w-8 md:h-8 text-welding-orange shrink-0 transition-transform duration-300 group-hover:scale-110" viewBox="0 0 32 32" fill="none" aria-hidden="true">
				<line x1="16" y1="28" x2="16" y2="12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
				<circle cx="16" cy="10" r="3" fill="currentColor" opacity="0.9" />
				<line x1="16" y1="6" x2="16" y2="2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
				<line x1="16" y1="10" x2="10" y2="4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
				<line x1="16" y1="10" x2="22" y2="4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
				<line x1="16" y1="10" x2="8" y2="8" stroke="currentColor" stroke-width="1" stroke-linecap="round" opacity="0.7" />
				<line x1="16" y1="10" x2="24" y2="8" stroke="currentColor" stroke-width="1" stroke-linecap="round" opacity="0.7" />
				<circle cx="12" cy="5" r="1" fill="currentColor" opacity="0.6" />
				<circle cx="21" cy="3" r="0.8" fill="currentColor" opacity="0.5" />
			</svg>
			<div class="font-heading leading-none">
				<span class="block text-[0.65rem] md:text-xs font-medium tracking-[0.25em] text-ash uppercase">Taller</span>
				<span class="block text-base md:text-xl font-bold tracking-wide text-smoke group-hover:text-welding-orange transition-colors duration-200 uppercase">Los Camilos</span>
			</div>
		</a>

		<!-- Desktop nav -->
		<div class="hidden md:flex items-center gap-8">
			<ul class="flex items-center gap-8" role="list">
				{navLinks.map((link) => (
					<li>
						<a
							href={link.href}
							data-section={link.section}
							class="nav-link relative py-1 text-sm font-medium tracking-wide text-ash uppercase hover:text-smoke transition-colors duration-200"
						>
							{link.label}
							<span class="nav-underline absolute left-0 -bottom-1 h-[2px] w-0 bg-welding-orange transition-all duration-300 ease-out"></span>
						</a>
					</li>
				))}
			</ul>
			<a
				href={whatsappLink}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-2 px-5 py-2 text-sm font-bold font-heading uppercase tracking-wide bg-welding-orange text-charcoal rounded hover:bg-forge-yellow transition-colors duration-200"
			>
				<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
				</svg>
				Contactar
			</a>
		</div>

		<!-- Mobile hamburger -->
		<button
			id="menu-toggle"
			type="button"
			class="md:hidden w-10 h-10 flex items-center justify-center text-smoke"
			aria-label="Menú"
			aria-expanded="false"
		>
			<svg id="icon-open" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
				<line x1="3" y1="6" x2="21" y2="6" />
				<line x1="3" y1="12" x2="21" y2="12" />
				<line x1="3" y1="18" x2="21" y2="18" />
			</svg>
			<svg id="icon-close" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" style="display:none;">
				<line x1="18" y1="6" x2="6" y2="18" />
				<line x1="6" y1="6" x2="18" y2="18" />
			</svg>
		</button>
	</nav>

	<!-- Mobile dropdown menu (hidden by default via inline style) -->
	<div id="mobile-menu" style="display:none;" aria-hidden="true">
		<nav class="px-6 pb-6 pt-2" aria-label="Navegación móvil">
			<ul role="list">
				{navLinks.map((link) => (
					<li>
						<a
							href={link.href}
							data-section={link.section}
							class="mobile-nav-link block py-4 text-smoke font-heading text-lg font-bold uppercase tracking-widest border-b border-white/10 hover:text-welding-orange transition-colors"
						>
							{link.label}
						</a>
					</li>
				))}
			</ul>
			<a
				href={whatsappLink}
				target="_blank"
				rel="noopener noreferrer"
				class="mt-5 flex items-center justify-center gap-2 w-full py-3.5 font-bold font-heading uppercase tracking-wide bg-welding-orange text-charcoal rounded-lg hover:bg-forge-yellow transition-colors"
			>
				<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
				</svg>
				Contactar por WhatsApp
			</a>
		</nav>
	</div>
</header>

<style>
	.nav-link:hover .nav-underline,
	.nav-link.active .nav-underline {
		width: 100%;
	}
	.nav-link.active {
		color: var(--color-welding-orange);
	}
	.mobile-nav-link.active {
		color: var(--color-welding-orange);
	}
	.header-scrolled {
		background-color: color-mix(in srgb, var(--color-charcoal) 97%, transparent);
	}
	.header-scrolled nav {
		padding-top: 0.75rem;
		padding-bottom: 0.75rem;
	}
</style>

<script>
	const menuToggle = document.getElementById('menu-toggle')!;
	const mobileMenu = document.getElementById('mobile-menu')!;
	const iconOpen = document.getElementById('icon-open')!;
	const iconClose = document.getElementById('icon-close')!;
	const header = document.getElementById('site-header')!;

	let isOpen = false;

	function toggle() {
		isOpen = !isOpen;
		// Toggle menu visibility with inline styles (no CSS class games)
		mobileMenu.style.display = isOpen ? 'block' : 'none';
		mobileMenu.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
		menuToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
		// Swap icons
		iconOpen.style.display = isOpen ? 'none' : 'block';
		iconClose.style.display = isOpen ? 'block' : 'none';
		// Lock scroll
		document.body.style.overflow = isOpen ? 'hidden' : '';
		// Solid background when open
		header.style.backgroundColor = isOpen ? '#1C1C1C' : '';
	}

	menuToggle.addEventListener('click', toggle);

	// Close on nav link click
	mobileMenu.querySelectorAll('a[href^="#"]').forEach((link) => {
		link.addEventListener('click', () => { if (isOpen) toggle(); });
	});

	// Close on Escape
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && isOpen) toggle();
	});

	// Header shrink on scroll
	let ticking = false;
	window.addEventListener('scroll', () => {
		if (!ticking) {
			requestAnimationFrame(() => {
				header.classList.toggle('header-scrolled', window.scrollY > 40);
				ticking = false;
			});
			ticking = true;
		}
	}, { passive: true });

	// Scroll-spy
	const sectionIds = ['servicios', 'galeria', 'contacto'];
	const allNavLinks = document.querySelectorAll<HTMLAnchorElement>('[data-section]');
	const visible = new Map<string, boolean>();

	const obs = new IntersectionObserver((entries) => {
		entries.forEach((e) => visible.set(e.target.id, e.isIntersecting));
		const activeId = sectionIds.find((id) => visible.get(id)) || null;
		allNavLinks.forEach((link) => {
			link.classList.toggle('active', link.dataset.section === activeId);
		});
	}, { rootMargin: '-20% 0px -60% 0px', threshold: 0 });

	sectionIds.forEach((id) => {
		const el = document.getElementById(id);
		if (el) obs.observe(el);
	});
</script>
