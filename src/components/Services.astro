---
import ServiceCard from './ServiceCard.astro';

const services = [
	{
		title: "Pailas Ganaderas",
		description: "¿Necesita transportar agua para su ganado? Fabricamos pailas a la medida de su camión o pick-up, con lámina gruesa para que le dure años.",
		icon: "lucide:droplets",
		whatsappMessage: "Hola, necesito una paila ganadera. ¿Me puede dar precio?"
	},
	{
		title: "Maquinaria Agrícola",
		description: "Picadora parada, forrajera dañada o molino que no muele — tráigala y la dejamos funcionando. Reparamos todo tipo de equipo de campo.",
		icon: "lucide:settings",
		whatsappMessage: "Hola, necesito reparar maquinaria agrícola. ¿Puedo llevarla al taller?"
	},
	{
		title: "Soldadura de Arco",
		description: "Desde portones hasta estructuras pesadas — soldamos hierro y acero con arco eléctrico. Uniones fuertes que no se quiebran.",
		icon: "lucide:flame",
		whatsappMessage: "Hola, necesito un trabajo de soldadura. ¿Me puede cotizar?"
	},
	{
		title: "Techados Metálicos",
		description: "¿Techo con goteras o necesita uno nuevo? Construimos y reparamos techos para casas, bodegas, establos y galeras.",
		icon: "lucide:warehouse",
		whatsappMessage: "Hola, necesito cotizar un techado metálico."
	},
	{
		title: "Básculas y Romanas",
		description: "Si su báscula no pesa bien, la reparamos y calibramos. Servicio para uso ganadero, agrícola y comercial.",
		icon: "lucide:scale",
		whatsappMessage: "Hola, necesito reparar una báscula/romana. ¿Tienen disponibilidad?"
	}
];
---

<section id="servicios" class="py-20 md:py-28 px-4 bg-charcoal metal-texture">
	<div class="max-w-6xl mx-auto">
		<div class="text-center mb-12">
			<h2 class="font-heading text-3xl md:text-4xl font-bold text-smoke mb-4 gsap-hidden">
				NUESTROS <span class="text-welding-orange">SERVICIOS</span>
			</h2>
			<p class="text-ash max-w-xl mx-auto text-lg">
				Lo que necesite en soldadura, lo hacemos — y lo hacemos bien
			</p>
			<div class="w-24 h-1 bg-welding-orange mx-auto mt-4 rounded-full gsap-hidden"></div>
		</div>

		<!-- 2-column grid: first 4 cards, then 5th card spanning full or centered -->
		<div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="services-grid">
			{services.slice(0, 4).map((service) => (
				<div class="gsap-hidden">
					<ServiceCard
						title={service.title}
						description={service.description}
						icon={service.icon}
						whatsappMessage={service.whatsappMessage}
					/>
				</div>
			))}
			<!-- 5th card centered on its own row -->
			<div class="md:col-span-2 md:max-w-lg md:mx-auto gsap-hidden">
				<ServiceCard
					title={services[4].title}
					description={services[4].description}
					icon={services[4].icon}
					whatsappMessage={services[4].whatsappMessage}
				/>
			</div>
		</div>
	</div>
</section>

<script>
	import {
		gsap, reveal, isReducedMotion, animateSectionTitle,
		EASE, DURATION, STAGGER, defaultScrollTrigger,
	} from '../scripts/gsap-init';

	function initServicesAnimation() {
		const grid = document.querySelector('#services-grid');
		if (!grid) return;

		const cards = grid.querySelectorAll(':scope > div');
		if (!cards.length) return;

		// Section title animation
		animateSectionTitle(
			'#servicios .text-center h2',
			'#servicios .text-center .w-24'
		);

		// Reveal cards before animating
		reveal(cards);

		if (isReducedMotion()) {
			gsap.from(cards, {
				opacity: 0,
				duration: 0.3,
				stagger: 0.05,
				scrollTrigger: {
					trigger: grid,
					start: 'top 80%',
					toggleActions: 'play none none reverse',
				},
			});
			return;
		}

		const isMobile = window.matchMedia('(max-width: 767px)').matches;

		if (isMobile) {
			gsap.from(cards, {
				y: 30,
				opacity: 0,
				duration: DURATION.default,
				stagger: STAGGER.default,
				ease: EASE.entrance,
				scrollTrigger: {
					trigger: grid,
					start: 'top 80%',
					toggleActions: 'play none none reverse',
				},
			});
		} else {
			gsap.from(cards, {
				rotateX: 15,
				y: 60,
				opacity: 0,
				duration: DURATION.default,
				stagger: STAGGER.cards,
				ease: EASE.entrance,
				transformPerspective: 800,
				transformOrigin: 'center bottom',
				scrollTrigger: {
					trigger: grid,
					start: 'top 80%',
					toggleActions: 'play none none reverse',
				},
			});
		}
	}

	initServicesAnimation();
</script>
