---
import { Icon } from 'astro-icon/components';

const phone = "99505549";
const whatsappLink = `https://wa.me/504${phone}`;
const phoneLink = `tel:+504${phone}`;
const mapsLink = "https://maps.app.goo.gl/7FSxQtjbjdvgrZr77";
const mapsEmbed = "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3847.123!2d-85.7247553!3d15.7461602!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMTXCsDQ0JzQ2LjIiTiA4NcKwNDMnMjkuMSJX!5e0!3m2!1ses!2shn!4v1";
---

<section id="contacto" class="py-20 md:py-28 px-4 bg-charcoal">
	<div class="max-w-5xl mx-auto">
		<!-- Heading: centered with forge-yellow accent -->
		<div class="text-center mb-12 md:mb-16">
			<p class="gsap-hidden font-heading text-sm md:text-base tracking-widest text-forge-yellow uppercase mb-3">Contáctenos</p>
			<h2 class="gsap-hidden font-heading text-3xl md:text-4xl lg:text-5xl font-bold text-smoke mb-4">
				Estamos a su disposición
			</h2>
			<p class="gsap-hidden text-ash max-w-md mx-auto">
				Escríbanos o llámenos para cotizar su proyecto. Le atendemos con gusto.
			</p>
		</div>

		<div class="grid md:grid-cols-5 gap-8 lg:gap-10">
			<!-- Contact card: spans 2 columns on md+ -->
			<div class="md:col-span-2 gsap-hidden">
				<div class="bg-steel rounded-2xl p-6 md:p-8 h-full flex flex-col">
					<!-- Phone -->
					<a href={phoneLink} class="flex items-center gap-4 group mb-6">
						<div class="w-11 h-11 shrink-0 bg-charcoal rounded-lg flex items-center justify-center group-hover:bg-welding-orange/10 transition-colors">
							<Icon name="lucide:phone" class="w-5 h-5 text-welding-orange" />
						</div>
						<div>
							<p class="text-ash text-xs uppercase tracking-wide">Teléfono</p>
							<p class="text-smoke text-lg font-medium group-hover:text-welding-orange transition-colors">{phone}</p>
						</div>
					</a>

					<!-- Location -->
					<div class="flex items-center gap-4 mb-6">
						<div class="w-11 h-11 shrink-0 bg-charcoal rounded-lg flex items-center justify-center">
							<Icon name="lucide:map-pin" class="w-5 h-5 text-welding-orange" />
						</div>
						<div>
							<p class="text-ash text-xs uppercase tracking-wide">Ubicación</p>
							<p class="text-smoke font-medium">Bonito Oriental, Colón</p>
							<p class="text-ash text-sm">Honduras</p>
						</div>
					</div>

					<!-- Hours -->
					<div class="flex items-start gap-4 mb-8">
						<div class="w-11 h-11 shrink-0 bg-charcoal rounded-lg flex items-center justify-center mt-0.5">
							<Icon name="lucide:clock" class="w-5 h-5 text-welding-orange" />
						</div>
						<div class="flex-1">
							<p class="text-ash text-xs uppercase tracking-wide mb-2">Horario</p>
							<div class="space-y-1.5 text-sm">
								<div class="flex justify-between">
									<span class="text-ash">Lun – Vie</span>
									<span class="text-smoke font-medium">7:00 - 12:00, 1:00 - 4:00 PM</span>
								</div>
								<div class="flex justify-between">
									<span class="text-ash">Sábado</span>
									<span class="text-smoke font-medium">7:00 AM – 12:00 PM</span>
								</div>
								<div class="flex justify-between">
									<span class="text-ash">Domingo</span>
									<span class="text-ash/60">Cerrado</span>
								</div>
							</div>
						</div>
					</div>

					<!-- Divider -->
					<div class="border-t border-charcoal mb-6"></div>

					<!-- WhatsApp CTA (full width, prominent) -->
					<a
						href={whatsappLink}
						target="_blank"
						rel="noopener noreferrer"
						class="flex items-center justify-center gap-3 w-full bg-[#25D366] hover:bg-[#128C7E] text-white font-heading font-bold py-4 px-6 rounded-xl transition-colors mt-auto"
					>
						<Icon name="lucide:message-circle" class="w-6 h-6" />
						Escríbanos por WhatsApp
					</a>
				</div>
			</div>

			<!-- Map: spans 3 columns on md+ -->
			<div class="md:col-span-3 gsap-hidden flex flex-col gap-4">
				<div
					id="map-container"
					class="bg-steel rounded-2xl overflow-hidden min-h-[350px] md:min-h-[420px] relative flex-1"
				>
					<!-- Static placeholder (shown before map loads) -->
					<div
						id="map-placeholder"
						class="absolute inset-0 flex flex-col items-center justify-center gap-4 bg-steel p-6 text-center cursor-pointer group"
						role="button"
						tabindex="0"
						aria-label="Cargar mapa interactivo de Google Maps"
					>
						<div class="w-16 h-16 rounded-full bg-charcoal flex items-center justify-center group-hover:bg-welding-orange/10 transition-colors">
							<Icon name="lucide:map" class="w-8 h-8 text-welding-orange" />
						</div>
						<div>
							<p class="text-smoke font-heading font-semibold text-lg mb-1">Bonito Oriental, Colón</p>
							<p class="text-ash text-sm">Honduras</p>
						</div>
						<span class="inline-flex items-center gap-2 text-welding-orange font-medium text-sm group-hover:underline">
							<Icon name="lucide:mouse-pointer-click" class="w-4 h-4" />
							Ver mapa interactivo
						</span>
					</div>

					<!-- Iframe inserted here on click -->
				</div>

				<!-- Open in Google Maps button -->
				<a
					href={mapsLink}
					target="_blank"
					rel="noopener noreferrer"
					class="flex items-center justify-center gap-2 bg-steel hover:bg-welding-orange/10 text-smoke font-medium py-3 px-6 rounded-xl transition-colors border border-ash/20 hover:border-welding-orange"
				>
					<Icon name="lucide:external-link" class="w-4 h-4 text-welding-orange" />
					Abrir en Google Maps
				</a>
			</div>
		</div>
	</div>
</section>

<script define:vars={{ mapsEmbed }}>
	// Lazy-load the Google Maps iframe only when user clicks the placeholder
	function initLazyMap() {
		const placeholder = document.getElementById('map-placeholder');
		const container = document.getElementById('map-container');
		if (!placeholder || !container) return;

		function loadMap() {
			const iframe = document.createElement('iframe');
			iframe.src = mapsEmbed;
			iframe.width = '100%';
			iframe.height = '100%';
			iframe.style.border = '0';
			iframe.style.position = 'absolute';
			iframe.style.inset = '0';
			iframe.allowFullscreen = true;
			iframe.loading = 'lazy';
			iframe.referrerPolicy = 'no-referrer-when-downgrade';
			iframe.title = 'Ubicación de Taller Los Camilos';
			iframe.className = 'w-full h-full';

			placeholder.remove();
			container.appendChild(iframe);
		}

		placeholder.addEventListener('click', loadMap);
		placeholder.addEventListener('keydown', (e) => {
			if (e.key === 'Enter' || e.key === ' ') {
				e.preventDefault();
				loadMap();
			}
		});
	}

	initLazyMap();
</script>

<script>
	import {
		gsap, reveal, isReducedMotion, EASE, DURATION,
	} from '../scripts/gsap-init';

	function initContactAnimation() {
		// -- Heading animations --
		const subtitle = document.querySelector('#contacto .text-center p:first-child');
		const heading = document.querySelector('#contacto .text-center h2');
		const desc = document.querySelector('#contacto .text-center p:last-child');
		const headingEls = [subtitle, heading, desc].filter(Boolean) as Element[];

		headingEls.forEach(el => reveal(el));

		if (isReducedMotion()) {
			gsap.from(headingEls, {
				opacity: 0,
				duration: 0.3,
				stagger: 0.1,
				scrollTrigger: {
					trigger: '#contacto .text-center',
					start: 'top 85%',
					toggleActions: 'play none none none',
				},
			});
		} else {
			gsap.from(headingEls, {
				y: 20,
				opacity: 0,
				duration: DURATION.default,
				ease: EASE.entrance,
				stagger: 0.12,
				scrollTrigger: {
					trigger: '#contacto .text-center',
					start: 'top 85%',
					toggleActions: 'play none none none',
				},
			});
		}

		// -- Card + Map columns --
		const grid = document.querySelector('#contacto .grid');
		if (!grid) return;

		const leftColumn = grid.querySelector(':scope > div:first-child');
		const rightColumn = grid.querySelector(':scope > div:last-child');
		if (!leftColumn || !rightColumn) return;

		reveal([leftColumn, rightColumn]);

		if (isReducedMotion()) {
			gsap.from([leftColumn, rightColumn], {
				opacity: 0,
				duration: 0.3,
				stagger: 0.1,
				scrollTrigger: {
					trigger: grid,
					start: 'top 80%',
					toggleActions: 'play none none none',
				},
			});
			return;
		}

		const isMobile = window.matchMedia('(max-width: 767px)').matches;

		if (isMobile) {
			gsap.from([leftColumn, rightColumn], {
				y: 30,
				opacity: 0,
				duration: DURATION.default,
				stagger: 0.2,
				ease: EASE.entrance,
				scrollTrigger: {
					trigger: grid,
					start: 'top 80%',
					toggleActions: 'play none none none',
				},
			});
		} else {
			const tl = gsap.timeline({
				scrollTrigger: {
					trigger: grid,
					start: 'top 80%',
					toggleActions: 'play none none none',
				},
			});

			tl.from(leftColumn, {
				x: -50,
				opacity: 0,
				duration: DURATION.default,
				ease: EASE.entrance,
			});

			tl.from(rightColumn, {
				x: 50,
				opacity: 0,
				duration: DURATION.default,
				ease: EASE.entrance,
			}, '-=0.5');
		}
	}

	initContactAnimation();
</script>
