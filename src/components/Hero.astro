---
import { Icon } from 'astro-icon/components';
---

<section class="min-h-screen flex items-center justify-center relative overflow-hidden pt-16">
	<!-- Background image -->
	<img
		src="https://i.postimg.cc/wTcF56H5/4.jpg"
		alt=""
		class="absolute inset-0 w-full h-full object-cover"
		loading="eager"
	/>
	<!-- Gradient overlay: darker at bottom for text, lighter at top to show image -->
	<div class="absolute inset-0 bg-gradient-to-t from-charcoal/80 via-charcoal/50 to-charcoal/30"></div>

	<!-- Animated sparks -->
	<div class="sparks-container">
		<div class="spark"></div>
		<div class="spark"></div>
		<div class="spark"></div>
		<div class="spark"></div>
		<div class="spark"></div>
		<div class="spark"></div>
	</div>

	<div class="relative z-10 text-center px-4 max-w-4xl mx-auto gsap-hidden" data-hero-content>
		<!-- Welding icon — distinctive flame treatment -->
		<div class="mb-6 flex justify-center" data-hero-icon>
			<div class="w-16 h-16 md:w-20 md:h-20 flex items-center justify-center rounded-full border-2 border-welding-orange/40 bg-charcoal/60 backdrop-blur-sm">
				<Icon name="lucide:flame" class="w-9 h-9 md:w-11 md:h-11 text-welding-orange" />
			</div>
		</div>

		<h1 class="font-heading text-4xl md:text-6xl lg:text-7xl font-bold text-smoke mb-4 tracking-tight leading-tight" data-hero-title>
			CONSTRUIMOS LO QUE<br class="hidden sm:block" />
			<span class="text-welding-orange" data-hero-accent>EL CAMPO NECESITA</span>
		</h1>

		<p class="text-lg md:text-xl text-ash max-w-2xl mx-auto mb-10 leading-relaxed" data-hero-subtitle>
			Pailas ganaderas, reparación de maquinaria agrícola, techados y soldadura
			de arco eléctrico — más de 15 años sirviendo a
			<span class="text-smoke font-medium">Bonito Oriental y toda la región de Colón.</span>
		</p>

		<div class="flex flex-col sm:flex-row gap-4 justify-center" data-hero-ctas>
			<a
				href="#contacto"
				class="group inline-flex items-center justify-center gap-2.5 bg-welding-orange hover:bg-forge-yellow text-charcoal font-heading font-bold text-lg uppercase tracking-wide px-8 py-4 rounded-lg transition-all duration-200 hover:shadow-[0_0_24px_rgba(249,115,22,0.35)]"
			>
				<Icon name="lucide:phone" class="w-5 h-5 transition-transform duration-200 group-hover:scale-110" />
				Contáctenos
			</a>
			<a
				href="#servicios"
				class="group inline-flex items-center justify-center gap-2.5 border-2 border-smoke/30 hover:border-welding-orange text-smoke hover:text-welding-orange font-heading font-bold text-lg uppercase tracking-wide px-8 py-4 rounded-lg transition-all duration-200 hover:bg-welding-orange/10"
			>
				<Icon name="lucide:wrench" class="w-5 h-5 transition-transform duration-200 group-hover:rotate-12" />
				Ver Servicios
			</a>
		</div>
	</div>

	<!-- Scroll indicator -->
	<div class="absolute bottom-8 left-1/2 -translate-x-1/2" data-hero-scroll-indicator style="opacity: 0;">
		<Icon name="lucide:chevron-down" class="w-6 h-6 text-ash animate-bounce" />
	</div>
</section>

<style>
	.sparks-container {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		overflow: hidden;
		pointer-events: none;
	}

	.spark {
		position: absolute;
		width: 3px;
		height: 3px;
		background: linear-gradient(to bottom, #FBBF24, #F97316);
		border-radius: 50%;
		opacity: 0;
		box-shadow: 0 0 4px 1px rgba(249, 115, 22, 0.6);
	}

	.spark::after {
		content: '';
		position: absolute;
		top: 0;
		left: 50%;
		transform: translateX(-50%);
		width: 1px;
		height: 12px;
		background: linear-gradient(to bottom, rgba(251, 191, 36, 0.6), transparent);
	}

	/* Mobile CSS fallback for sparks (max 3 visible) */
	@media (max-width: 767px) {
		.spark:nth-child(n+4) {
			display: none;
		}
		.spark:nth-child(1) { left: 25%; animation: fall-mobile 3s linear infinite 0s; }
		.spark:nth-child(2) { left: 50%; animation: fall-mobile 2.5s linear infinite 0.8s; }
		.spark:nth-child(3) { left: 75%; animation: fall-mobile 3.5s linear infinite 1.5s; }
	}

	@keyframes fall-mobile {
		0% {
			transform: translateY(-20px);
			opacity: 0.8;
		}
		15% {
			opacity: 1;
		}
		70% {
			opacity: 0.5;
		}
		100% {
			transform: translateY(100vh);
			opacity: 0;
		}
	}

	/* Hide sparks entirely when user prefers reduced motion */
	@media (prefers-reduced-motion: reduce) {
		.sparks-container {
			display: none;
		}
	}
</style>

<script>
	import {
		gsap,
		reveal,
		isReducedMotion,
		EASE,
		STAGGER,
	} from '../scripts/gsap-init';

	function initHeroAnimation() {
		const heroContent = document.querySelector('[data-hero-content]') as HTMLElement | null;
		if (!heroContent) return;

		reveal(heroContent);

		const iconEl = document.querySelector('[data-hero-icon]') as HTMLElement | null;
		const title = document.querySelector('[data-hero-title]') as HTMLElement | null;
		const accentSpan = document.querySelector('[data-hero-accent]') as HTMLElement | null;
		const subtitle = document.querySelector('[data-hero-subtitle]') as HTMLElement | null;
		const ctasContainer = document.querySelector('[data-hero-ctas]') as HTMLElement | null;
		const scrollIndicator = document.querySelector('[data-hero-scroll-indicator]') as HTMLElement | null;

		if (isReducedMotion()) {
			gsap.from(heroContent, {
				opacity: 0,
				duration: 0.3,
			});
			if (scrollIndicator) {
				gsap.set(scrollIndicator, { opacity: 1 });
			}
			return;
		}

		const isMobile = window.matchMedia('(max-width: 767px)').matches;

		// Split title into word spans for staggered reveal
		if (title) {
			const h1 = title;
			const originalHTML = h1.innerHTML;
			const parts = originalHTML.split(/(<span[^>]*>.*?<\/span>|<br[^>]*\/?>)/);
			let wordHTML = '';

			parts.forEach(part => {
				if (part.startsWith('<span') || part.startsWith('<br')) {
					wordHTML += `<span class="hero-word" style="display:inline-block;">${part}</span> `;
				} else {
					const words = part.trim().split(/\s+/);
					words.forEach(word => {
						if (word) {
							wordHTML += `<span class="hero-word" style="display:inline-block;">${word}</span> `;
						}
					});
				}
			});

			h1.innerHTML = wordHTML.trim();
		}

		const words = document.querySelectorAll('.hero-word');
		const ctaButtons = ctasContainer ? ctasContainer.querySelectorAll('a') : [];

		const tl = gsap.timeline({ delay: 0.2 });

		// Icon: bright flash on load (desktop), then scale in
		if (iconEl && !isMobile) {
			tl.fromTo(iconEl, {
				filter: 'brightness(3) drop-shadow(0 0 30px rgba(255, 255, 255, 0.9))',
			}, {
				filter: 'brightness(1) drop-shadow(0 0 0px transparent)',
				duration: 0.3,
				ease: 'power2.out',
			}, 0);
		}

		if (iconEl) {
			tl.from(iconEl, {
				scale: 0,
				opacity: 0,
				duration: 0.6,
				ease: EASE.bounce,
			}, isMobile ? 0 : 0.1);
		}

		// Word-by-word reveal
		if (words.length > 0) {
			const wordStagger = isMobile ? 0.05 : STAGGER.words;
			tl.from(words, {
				y: 40,
				opacity: 0,
				duration: 0.6,
				stagger: wordStagger,
				ease: EASE.entrance,
			}, isMobile ? 0.3 : 0.4);
		}

		// Accent scale pulse
		if (accentSpan) {
			const accentWord = accentSpan.closest('.hero-word') || accentSpan;
			tl.to(accentWord, {
				scale: 1.05,
				duration: 0.15,
				ease: 'power2.in',
			}, isMobile ? '>' : 0.8);
			tl.to(accentWord, {
				scale: 1,
				duration: 0.15,
				ease: 'power2.out',
			});
		}

		// Subtitle slide up
		if (subtitle) {
			tl.from(subtitle, {
				y: 30,
				opacity: 0,
				duration: 0.6,
				ease: EASE.entrance,
			}, isMobile ? '>' : 0.9);
		}

		// CTA buttons staggered
		if (ctaButtons.length > 0) {
			tl.from(ctaButtons, {
				y: 20,
				opacity: 0,
				duration: 0.5,
				stagger: 0.12,
				ease: EASE.bounce,
			}, isMobile ? '>' : 1.1);
		}

		// Scroll indicator
		if (scrollIndicator) {
			tl.to(scrollIndicator, {
				opacity: 1,
				duration: 0.4,
				ease: EASE.entrance,
			}, isMobile ? '>' : 1.5);
		}

		// GSAP-enhanced sparks (desktop only)
		if (!isMobile) {
			initDesktopSparks();
		}
	}

	function initDesktopSparks() {
		const sparks = document.querySelectorAll('.spark');
		if (!sparks.length) return;

		sparks.forEach(spark => {
			(spark as HTMLElement).style.animation = 'none';
		});

		sparks.forEach((spark) => {
			const el = spark as HTMLElement;
			const startLeft = gsap.utils.random(5, 95);
			el.style.left = `${startLeft}%`;

			animateSpark(el);
		});
	}

	function animateSpark(spark: HTMLElement) {
		const startY = gsap.utils.random(-50, -20);
		const drift = gsap.utils.random(-60, 60);
		const duration = gsap.utils.random(2.5, 4.5);
		const delay = gsap.utils.random(0, 2.5);
		const rotation = gsap.utils.random(360, 720);
		const scale = gsap.utils.random(0.5, 1.3);

		gsap.fromTo(spark, {
			y: startY,
			x: 0,
			opacity: 1,
			scale: scale,
			rotation: 0,
		}, {
			y: '100vh',
			x: drift,
			rotation: rotation,
			opacity: 0,
			duration: duration,
			ease: 'none',
			delay: delay,
			repeat: -1,
			repeatDelay: gsap.utils.random(0.5, 1.5),
			onRepeat: function() {
				const newLeft = gsap.utils.random(5, 95);
				spark.style.left = `${newLeft}%`;
			}
		});
	}

	initHeroAnimation();
</script>
