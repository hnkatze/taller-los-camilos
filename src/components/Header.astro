---
const navLinks = [
	{ href: "#servicios", label: "Servicios", section: "servicios" },
	{ href: "#galeria", label: "Galería", section: "galeria" },
	{ href: "#contacto", label: "Contacto", section: "contacto" },
];

const whatsappLink = "https://wa.me/50499505549";
---

<header
	id="site-header"
	class="fixed top-0 left-0 right-0 z-50 bg-charcoal/90 backdrop-blur-md transition-all duration-300 ease-out"
>
	<!-- Subtle orange bottom accent line -->
	<div class="absolute bottom-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-welding-orange/60 to-transparent"></div>

	<nav class="max-w-6xl mx-auto px-4 sm:px-6 py-5 flex items-center justify-between transition-all duration-300" aria-label="Navegación principal">
		<!-- Logo -->
		<a
			href="/"
			class="group flex items-center gap-2.5 no-underline"
			aria-label="Taller Los Camilos - Inicio"
		>
			<!-- Welding spark SVG icon -->
			<svg
				class="w-7 h-7 md:w-8 md:h-8 text-welding-orange shrink-0 transition-transform duration-300 group-hover:scale-110"
				viewBox="0 0 32 32"
				fill="none"
				aria-hidden="true"
			>
				<!-- Central welding rod -->
				<line x1="16" y1="28" x2="16" y2="12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
				<!-- Welding arc glow -->
				<circle cx="16" cy="10" r="3" fill="currentColor" opacity="0.9" />
				<!-- Spark rays bursting from the arc point -->
				<line x1="16" y1="6" x2="16" y2="2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
				<line x1="16" y1="10" x2="10" y2="4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
				<line x1="16" y1="10" x2="22" y2="4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
				<line x1="16" y1="10" x2="8" y2="8" stroke="currentColor" stroke-width="1" stroke-linecap="round" opacity="0.7" />
				<line x1="16" y1="10" x2="24" y2="8" stroke="currentColor" stroke-width="1" stroke-linecap="round" opacity="0.7" />
				<!-- Small spark dots -->
				<circle cx="12" cy="5" r="1" fill="currentColor" opacity="0.6" />
				<circle cx="21" cy="3" r="0.8" fill="currentColor" opacity="0.5" />
				<circle cx="8" cy="6" r="0.7" fill="currentColor" opacity="0.4" />
				<circle cx="24" cy="6" r="0.7" fill="currentColor" opacity="0.4" />
			</svg>

			<div class="font-heading leading-none">
				<span class="block text-[0.65rem] md:text-xs font-medium tracking-[0.25em] text-ash uppercase">Taller</span>
				<span class="block text-base md:text-xl font-bold tracking-wide text-smoke group-hover:text-welding-orange transition-colors duration-200 uppercase">Los Camilos</span>
			</div>
		</a>

		<!-- Desktop navigation -->
		<div class="hidden md:flex items-center gap-8">
			<ul class="flex items-center gap-8" role="list">
				{navLinks.map((link) => (
					<li>
						<a
							href={link.href}
							data-section={link.section}
							class="nav-link relative py-1 text-sm font-medium tracking-wide text-ash uppercase hover:text-smoke transition-colors duration-200"
						>
							{link.label}
							<span class="nav-underline absolute left-0 -bottom-1 h-[2px] w-0 bg-welding-orange transition-all duration-300 ease-out"></span>
						</a>
					</li>
				))}
			</ul>

			<!-- CTA button -->
			<a
				href={whatsappLink}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-2 px-5 py-2 text-sm font-bold font-heading uppercase tracking-wide bg-welding-orange text-charcoal rounded hover:bg-forge-yellow transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-welding-orange"
			>
				<!-- Phone icon -->
				<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
				</svg>
				Contactar
			</a>
		</div>

		<!-- Mobile hamburger button -->
		<button
			id="menu-toggle"
			type="button"
			class="md:hidden relative w-10 h-10 flex items-center justify-center text-smoke hover:text-welding-orange transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-welding-orange rounded"
			aria-label="Abrir menú de navegación"
			aria-expanded="false"
			aria-controls="mobile-menu"
		>
			<!-- Hamburger icon lines (animated to X) -->
			<span class="hamburger-line absolute w-6 h-0.5 bg-current rounded-full transition-all duration-300 ease-out -translate-y-2" aria-hidden="true"></span>
			<span class="hamburger-line absolute w-6 h-0.5 bg-current rounded-full transition-all duration-300 ease-out" aria-hidden="true"></span>
			<span class="hamburger-line absolute w-4 h-0.5 bg-current rounded-full transition-all duration-300 ease-out translate-y-2" aria-hidden="true"></span>
		</button>
	</nav>

	<!-- Mobile menu overlay + panel -->
	<div
		id="mobile-menu"
		class="md:hidden fixed inset-0 top-0 z-40 pointer-events-none"
		aria-hidden="true"
		role="dialog"
		aria-label="Menú de navegación"
	>
		<!-- Backdrop -->
		<div id="menu-backdrop" class="absolute inset-0 bg-charcoal/80 backdrop-blur-sm opacity-0 transition-opacity duration-300 ease-out"></div>

		<!-- Slide-in panel -->
		<div
			id="menu-panel"
			class="absolute top-0 right-0 w-72 h-full bg-steel/98 backdrop-blur-lg shadow-2xl translate-x-full transition-transform duration-300 ease-out flex flex-col"
		>
			<!-- Panel header with close button -->
			<div class="flex items-center justify-between px-6 py-5 border-b border-ash/10">
				<span class="font-heading text-sm font-bold tracking-wider text-ash uppercase">Menú</span>
				<button
					id="menu-close"
					type="button"
					class="w-10 h-10 flex items-center justify-center text-ash hover:text-welding-orange transition-colors duration-200 rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-welding-orange"
					aria-label="Cerrar menú de navegación"
				>
					<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
						<line x1="18" y1="6" x2="6" y2="18" />
						<line x1="6" y1="6" x2="18" y2="18" />
					</svg>
				</button>
			</div>

			<!-- Nav links -->
			<nav class="flex-1 px-6 py-8" aria-label="Navegación móvil">
				<ul class="space-y-2" role="list">
					{navLinks.map((link) => (
						<li>
							<a
								href={link.href}
								data-section={link.section}
								class="mobile-nav-link flex items-center gap-3 px-4 py-3.5 rounded-lg text-smoke font-heading text-lg font-medium uppercase tracking-wide hover:bg-welding-orange/10 hover:text-welding-orange transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-welding-orange"
							>
								{link.label}
							</a>
						</li>
					))}
				</ul>
			</nav>

			<!-- CTA at bottom of panel -->
			<div class="px-6 pb-8">
				<a
					href={whatsappLink}
					target="_blank"
					rel="noopener noreferrer"
					class="mobile-nav-link flex items-center justify-center gap-2 w-full px-5 py-3.5 text-base font-bold font-heading uppercase tracking-wide bg-welding-orange text-charcoal rounded-lg hover:bg-forge-yellow transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-welding-orange"
				>
					<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
					</svg>
					Contactar por WhatsApp
				</a>
			</div>
		</div>
	</div>
</header>

<style>
	/* Hamburger → X animation when menu is open */
	[aria-expanded="true"] .hamburger-line:nth-child(1) {
		transform: rotate(45deg) translateY(0);
	}
	[aria-expanded="true"] .hamburger-line:nth-child(2) {
		opacity: 0;
	}
	[aria-expanded="true"] .hamburger-line:nth-child(3) {
		width: 1.5rem;
		transform: rotate(-45deg) translateY(0);
	}

	/* Desktop nav link underline hover */
	.nav-link:hover .nav-underline,
	.nav-link.active .nav-underline {
		width: 100%;
	}

	/* Active link state */
	.nav-link.active {
		color: var(--color-welding-orange);
	}
	.mobile-nav-link.active {
		color: var(--color-welding-orange);
		background-color: color-mix(in srgb, var(--color-welding-orange) 10%, transparent);
	}

	/* Header shrink state */
	.header-scrolled {
		background-color: color-mix(in srgb, var(--color-charcoal) 97%, transparent);
	}
	.header-scrolled nav {
		padding-top: 0.75rem;
		padding-bottom: 0.75rem;
	}
</style>

<script>
	// ====================
	// Mobile Menu Logic
	// ====================
	const menuToggle = document.getElementById('menu-toggle') as HTMLButtonElement;
	const menuClose = document.getElementById('menu-close') as HTMLButtonElement;
	const mobileMenu = document.getElementById('mobile-menu') as HTMLDivElement;
	const menuBackdrop = document.getElementById('menu-backdrop') as HTMLDivElement;
	const menuPanel = document.getElementById('menu-panel') as HTMLDivElement;
	const header = document.getElementById('site-header') as HTMLElement;

	// All focusable elements inside the mobile panel
	const getFocusableElements = (): HTMLElement[] => {
		return Array.from(
			menuPanel.querySelectorAll<HTMLElement>(
				'a[href], button, [tabindex]:not([tabindex="-1"])'
			)
		);
	};

	let isMenuOpen = false;

	function openMenu(): void {
		isMenuOpen = true;
		menuToggle.setAttribute('aria-expanded', 'true');
		mobileMenu.setAttribute('aria-hidden', 'false');
		mobileMenu.classList.remove('pointer-events-none');

		// Animate in
		menuBackdrop.classList.remove('opacity-0');
		menuBackdrop.classList.add('opacity-100');
		menuPanel.classList.remove('translate-x-full');
		menuPanel.classList.add('translate-x-0');

		// Lock body scroll
		document.body.style.overflow = 'hidden';

		// Focus the close button after transition
		setTimeout(() => menuClose.focus(), 310);
	}

	function closeMenu(): void {
		isMenuOpen = false;
		menuToggle.setAttribute('aria-expanded', 'false');
		mobileMenu.setAttribute('aria-hidden', 'true');

		// Animate out
		menuBackdrop.classList.remove('opacity-100');
		menuBackdrop.classList.add('opacity-0');
		menuPanel.classList.remove('translate-x-0');
		menuPanel.classList.add('translate-x-full');

		// Unlock body scroll
		document.body.style.overflow = '';

		// Return focus to toggle button
		setTimeout(() => {
			mobileMenu.classList.add('pointer-events-none');
			menuToggle.focus();
		}, 310);
	}

	menuToggle.addEventListener('click', () => {
		if (isMenuOpen) {
			closeMenu();
		} else {
			openMenu();
		}
	});

	menuClose.addEventListener('click', closeMenu);

	// Close on backdrop click
	menuBackdrop.addEventListener('click', closeMenu);

	// Close on link click
	mobileMenu.querySelectorAll('a[href]').forEach((link) => {
		link.addEventListener('click', closeMenu);
	});

	// Close on Escape
	document.addEventListener('keydown', (e: KeyboardEvent) => {
		if (e.key === 'Escape' && isMenuOpen) {
			closeMenu();
		}
	});

	// Focus trap within the mobile panel
	menuPanel.addEventListener('keydown', (e: KeyboardEvent) => {
		if (e.key !== 'Tab' || !isMenuOpen) return;

		const focusable = getFocusableElements();
		if (focusable.length === 0) return;

		const first = focusable[0];
		const last = focusable[focusable.length - 1];

		if (e.shiftKey) {
			if (document.activeElement === first) {
				e.preventDefault();
				last.focus();
			}
		} else {
			if (document.activeElement === last) {
				e.preventDefault();
				first.focus();
			}
		}
	});

	// ====================
	// Header Shrink on Scroll
	// ====================
	let ticking = false;
	function onScroll(): void {
		if (!ticking) {
			window.requestAnimationFrame(() => {
				if (window.scrollY > 40) {
					header.classList.add('header-scrolled');
				} else {
					header.classList.remove('header-scrolled');
				}
				ticking = false;
			});
			ticking = true;
		}
	}
	window.addEventListener('scroll', onScroll, { passive: true });
	onScroll();

	// ====================
	// Scroll-Spy with IntersectionObserver
	// ====================
	const sectionIds = ['servicios', 'galeria', 'contacto'];
	const navLinksAll = document.querySelectorAll<HTMLAnchorElement>('[data-section]');

	function setActiveSection(sectionId: string): void {
		navLinksAll.forEach((link) => {
			if (link.dataset.section === sectionId) {
				link.classList.add('active');
			} else {
				link.classList.remove('active');
			}
		});
	}

	function clearActiveSection(): void {
		navLinksAll.forEach((link) => link.classList.remove('active'));
	}

	// Track which sections are intersecting and pick the topmost visible one
	const visibleSections = new Map<string, boolean>();

	const observer = new IntersectionObserver(
		(entries) => {
			entries.forEach((entry) => {
				visibleSections.set(entry.target.id, entry.isIntersecting);
			});

			// Find the first visible section in DOM order
			let activeId: string | null = null;
			for (const id of sectionIds) {
				if (visibleSections.get(id)) {
					activeId = id;
					break;
				}
			}

			if (activeId) {
				setActiveSection(activeId);
			} else {
				clearActiveSection();
			}
		},
		{
			rootMargin: '-20% 0px -60% 0px',
			threshold: 0,
		}
	);

	sectionIds.forEach((id) => {
		const section = document.getElementById(id);
		if (section) observer.observe(section);
	});
</script>
